<style>
  :root{
    --green:#0b6e4f; --green-dark:#084c37; --gold:#f4a261;
    --bg:#f4f7f6; --card:#ffffff; --text:#1f2d2b; --muted:#5b6b68;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Segoe UI',system-ui,sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
  a{text-decoration:none;color:inherit}

  /* Top bar */
  .topbar{background:var(--green-dark);color:#fff;padding:.6rem 1.2rem;display:flex;justify-content:space-between;flex-wrap:wrap;font-size:.85rem}
  .topbar a{color:#cdeee3;margin-left:1rem}
  .topbar a:hover{color:var(--gold)}

  /* Header */
  header{background:linear-gradient(135deg,var(--green),var(--green-dark));color:#fff;padding:1.4rem 1.2rem;display:flex;align-items:center;gap:1rem;flex-wrap:wrap}
  .logo{width:54px;height:54px;border-radius:50%;background:var(--gold);color:var(--green-dark);display:grid;place-items:center;font-weight:800;font-size:1.4rem}
  header h1{font-size:1.35rem}
  header p{font-size:.85rem;opacity:.9}

  /* Layout */
  .layout{display:flex;min-height:70vh}
  .sidebar{width:240px;background:var(--card);border-right:1px solid #e3e8e6;padding:1rem 0;position:sticky;top:0;height:100vh;overflow-y:auto}
  .sidebar h3{font-size:.75rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);padding:0 1.2rem .5rem}
  .nav-item{display:block;padding:.7rem 1.2rem;cursor:pointer;border-left:3px solid transparent;transition:.15s}
  .nav-item:hover{background:#eef5f2}
  .nav-item.active{background:#e6f2ed;border-left-color:var(--green);color:var(--green-dark);font-weight:600}
  .main{flex:1;padding:1.6rem 2rem;max-width:900px}

  /* Sections */
  .section{display:none;animation:fade .3s ease}
  .section.active{display:block}
  @keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
  .section h2{color:var(--green-dark);margin-bottom:.4rem;font-size:1.5rem}
  .section .lead{color:var(--muted);margin-bottom:1.2rem}

  /* Cards */
  .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:1rem}
  .card{background:var(--card);border:1px solid #e3e8e6;border-radius:12px;padding:1rem;transition:.15s}
  .card:hover{border-color:var(--green);box-shadow:0 6px 18px rgba(11,110,79,.12);transform:translateY(-2px)}
  .card .tag{display:inline-block;background:#e6f2ed;color:var(--green-dark);font-size:.7rem;padding:.2rem .5rem;border-radius:20px;margin-bottom:.5rem}
  .card h4{font-size:1rem;margin-bottom:.3rem}
  .card p{font-size:.82rem;color:var(--muted)}
  .card .cap{font-size:.75rem;color:var(--gold);font-weight:600;margin-top:.5rem}

  /* Contact */
  .contact-list{list-style:none}
  .contact-list li{padding:.6rem 0;border-bottom:1px solid #eef2f1;display:flex;gap:.6rem}
  .contact-list b{min-width:90px;color:var(--green-dark)}

  /* Footer */
  footer{background:var(--green-dark);color:#cdeee3;text-align:center;padding:1.2rem;font-size:.8rem}

  /* Mobile */
  @media(max-width:760px){
    .sidebar{position:fixed;left:-260px;z-index:50;transition:.25s;box-shadow:4px 0 20px rgba(0,0,0,.2)}
    .sidebar.open{left:0}
    .main{padding:1.2rem}
    .burger{display:block!important}
  }
  .burger{display:none;background:none;border:none;color:#fff;font-size:1.6rem;cursor:pointer}
  .overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:40}
  .overlay.show{display:block}
</style>
</head>
